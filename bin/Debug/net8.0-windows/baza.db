
PRAGMA foreign_keys = ON;

CREATE TABLE IF NOT EXISTS Uzytkownik (
    Id INTEGER PRIMARY KEY AUTOINCREMENT,
    Imie TEXT NOT NULL,
    Nazwisko TEXT NOT NULL,
    Klasa TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS Sprzet (
    Id INTEGER PRIMARY KEY AUTOINCREMENT,
    Nazwa TEXT NOT NULL,
    Kategoria TEXT NOT NULL,
    Opis TEXT,
    Dostepny INTEGER NOT NULL DEFAULT 1
        CHECK (Dostepny IN (0, 1))
);

CREATE TABLE IF NOT EXISTS Wypozyczenie (
    Id INTEGER PRIMARY KEY AUTOINCREMENT,
    IdSprzetu INTEGER NOT NULL,
    IdUzytkownika INTEGER NOT NULL,
    DataWypozyczenia TEXT NOT NULL,
    PlanowanaDataZwrotu TEXT,
    DataZwrotu TEXT,
    Aktywne INTEGER NOT NULL DEFAULT 1
        CHECK (Aktywne IN (0, 1)),

    FOREIGN KEY (IdSprzetu) REFERENCES Sprzet(Id),
    FOREIGN KEY (IdUzytkownika) REFERENCES Uzytkownik(Id),

    CHECK (
        (Aktywne = 1 AND DataZwrotu IS NULL)
        OR
        (Aktywne = 0 AND DataZwrotu IS NOT NULL)
    )
);

CREATE UNIQUE INDEX IF NOT EXISTS JedenAktywnyNajem
ON Wypozyczenie(IdSprzetu)
WHERE Aktywne = 1;

CREATE INDEX IF NOT EXISTS IndeksWypozyczenUzytkownika
ON Wypozyczenie(IdUzytkownika);

CREATE INDEX IF NOT EXISTS IndeksWypozyczenSprzetu
ON Wypozyczenie(IdSprzetu);

